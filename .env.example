# ZALFI environment variables. Copy to .env (local) or add in Vercel → Settings → Environment
# Variables. Secrets live here only: the admin shows whether each integration is configured, never
# the values. Everything marked "optional" falls back to a local test provider when empty.

# ── Database ──────────────────────────────────────────────────────────────────────────────────────
# Local:      postgresql://postgres:postgres@localhost:5432/zalfi   (requests go through `npm run db:proxy`)
# Production: the pooled Neon connection string from Vercel → Storage → Neon (sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zalfi
# Port for the local Neon stand-in, HTTP and WebSocket (dev only)
NEON_LOCAL_PROXY_PORT=4444

# ── Site ──────────────────────────────────────────────────────────────────────────────────────────
# Public site URL: canonical URLs, sitemap, Open Graph, invitation links, payment return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin sign-in (Better Auth) ───────────────────────────────────────────────────────────────────
# Required in production. 32+ random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Optional: the admin's public URL if it differs from NEXT_PUBLIC_SITE_URL
BETTER_AUTH_URL=
# Only for `npm run admin:create-owner` without a prompt (automation). Leave empty normally.
ADMIN_OWNER_PASSWORD=

# ── Email: the e-receipt (Resend) — optional until going live ────────────────────────────────────
RESEND_API_KEY=
# The sender, on a domain verified in Resend, e.g. "ZALFI <receipts@zalfi.com>"
EMAIL_FROM=

# ── SMS: checkout phone verification — optional until going live ────────────────────────────────
# BulkSMSBD (bulksmsbd.net): API key and approved sender ID
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# ── Payments: SSLCommerz — optional until going live ─────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "true" for real payments; anything else uses the SSLCommerz sandbox
SSLCOMMERZ_IS_LIVE=false

# ── Courier: Pathao — optional until going live ──────────────────────────────────────────────────
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
# "true" for real deliveries; anything else uses the Pathao sandbox
PATHAO_IS_LIVE=false

# ── Courier: Steadfast — optional until going live ───────────────────────────────────────────────
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# ── File storage: product images (Vercel Blob) — optional; local files are used without it ──────
BLOB_READ_WRITE_TOKEN=

# ── Scheduled jobs (Vercel Cron) ─────────────────────────────────────────────────────────────────
# Required in production: a random string; cron requests must carry it
CRON_SECRET=
