# Postgres connection string.
# Local:      postgresql://postgres:postgres@localhost:5432/zalfi   (requests go through `npm run db:proxy`)
# Production: the pooled Neon connection string from Vercel → Storage → Neon (sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zalfi

# Public site URL, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Port for the local Neon HTTP stand-in (dev only)
NEON_LOCAL_PROXY_PORT=4444
