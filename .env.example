# ZALFI environment variables. Copy to .env (local, read by the site and the scripts) or add them
# in Vercel → Settings → Environment Variables (see docs/guides/deploy-vercel.md).
#
# Payment gateways, couriers, SMS and email are set up in the admin (Admin → Integrations): keys
# entered there are stored encrypted and win over these. The provider variables below are only a
# fallback, for a site set up before that page existed; leave them empty on a new site. Everything
# marked "optional" falls back to a local test provider when empty.

# ── Database ──────────────────────────────────────────────────────────────────────────────────────
# Local:      postgresql://postgres:postgres@localhost:5432/zalfi   (requests go through `npm run db:proxy`)
# Production: the pooled Neon connection string from Vercel → Storage → Neon (sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zalfi
# Port for the local Neon stand-in, HTTP and WebSocket (dev only)
NEON_LOCAL_PROXY_PORT=4444

# ── Site ──────────────────────────────────────────────────────────────────────────────────────────
# Public site URL: canonical URLs, sitemap, Open Graph, invitation links, payment return URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin sign-in (Better Auth) ───────────────────────────────────────────────────────────────────
# Required in production. 32+ random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Optional: the admin's public URL if it differs from NEXT_PUBLIC_SITE_URL
BETTER_AUTH_URL=
# Only for `npm run admin:create-owner` without a prompt (automation). Leave empty normally.
ADMIN_OWNER_PASSWORD=
# Optional: the key that encrypts provider keys saved in Admin → Integrations (32 bytes, base64:
# `openssl rand -base64 32`). Without it, a key is derived from BETTER_AUTH_SECRET. Changing either
# makes saved keys unreadable: the admin then asks for them again.
CREDENTIALS_KEY=

# ── Provider fallbacks (prefer Admin → Integrations) ─────────────────────────────────────────────

# ── Email: the e-receipt (Resend) — optional until going live ────────────────────────────────────
RESEND_API_KEY=
# The sender, on a domain verified in Resend, e.g. "ZALFI <receipts@zalfi.com>"
EMAIL_FROM=

# ── SMS: checkout phone verification — optional until going live ────────────────────────────────
# BulkSMSBD (bulksmsbd.net): API key and approved sender ID
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# ── Payments: SSLCommerz — optional until going live ─────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "true" for real payments; anything else uses the SSLCommerz sandbox
SSLCOMMERZ_IS_LIVE=false
# Its IPN reaches {NEXT_PUBLIC_SITE_URL}/api/payments/ipn/sslcommerz, so the site URL must be public.

# ── Payments: aamarPay — optional ─────────────────────────────────────────────────────────────────
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
# "true" for real payments; anything else uses the aamarPay sandbox
AAMARPAY_IS_LIVE=false

# ── Courier: Pathao — optional until going live ──────────────────────────────────────────────────
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
# "true" for real deliveries; anything else uses the Pathao sandbox
PATHAO_IS_LIVE=false
# Webhook: in Pathao's merchant panel, set the callback URL to
# {NEXT_PUBLIC_SITE_URL}/api/couriers/webhook/pathao and a secret of your choice (the same value
# here). Pathao shows an integration secret for its set-up check: put it in the second variable.
PATHAO_WEBHOOK_SECRET=
PATHAO_WEBHOOK_INTEGRATION_SECRET=

# ── Courier: Steadfast — optional until going live ───────────────────────────────────────────────
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Webhook: in Steadfast's panel, set the callback URL to
# {NEXT_PUBLIC_SITE_URL}/api/couriers/webhook/steadfast and an auth token (the same value here)
STEADFAST_WEBHOOK_TOKEN=

# ── Courier: RedX — optional ──────────────────────────────────────────────────────────────────────
REDX_ACCESS_TOKEN=
REDX_PICKUP_STORE_ID=
# "true" for real deliveries; anything else uses the RedX sandbox
REDX_IS_LIVE=false
# Webhook: give RedX {NEXT_PUBLIC_SITE_URL}/api/couriers/webhook/redx?token=<this value>
REDX_WEBHOOK_TOKEN=

# CarryBee, SSL Wireless, Alpha SMS, MiMSMS, Brevo, Postmark and SMTP have no variables here:
# they are set up in Admin → Integrations only.

# ── File storage: product images (Vercel Blob) — set by Vercel's Blob storage; local files without it
BLOB_READ_WRITE_TOKEN=

# ── Scheduled jobs (Vercel Cron, see vercel.json) ─────────────────────────────────────────────────
# Required in production: a random string. Vercel sends it with each job; jobs without it are refused.
CRON_SECRET=

# ── Test providers ───────────────────────────────────────────────────────────────────────────────
# The built-in test gateway and test courier run locally and on Vercel previews, never on the live
# site. On a production build that isn't live (a staging server), set this to "true" to allow them.
ALLOW_TEST_PROVIDERS=
